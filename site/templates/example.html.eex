<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= Site.h(@ex.title) %> · armless</title>
<meta name="description" content="<%= Site.h(@ex.description) %>">
<meta property="og:title" content="<%= Site.h(@ex.title) %> · armless">
<meta property="og:description" content="<%= Site.h(@ex.description) %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="armless">
<meta property="og:url" content="<%= @site %>/examples/<%= @ex.slug %>">
<meta property="og:image" content="<%= @site %>/og.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="armless: arm64 Linux, in a browser tab. Beside the headline, the Mandelbrot set as the page's machine draws it in its console.">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="dark">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/SpaceMono-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/style.css">
<script src="/site.js" defer></script>
<%= if @demo? do %><link rel="stylesheet" href="/demo/xterm.css">
<script src="/machine.js" defer></script>
<script src="/<%= @ex.script %>" defer></script><% end %>
</head>
<body class="landing">
<a class="skip" href="#machine">Skip to the machine</a>

<header class="bar">
  <a class="name" href="/">armless</a>
  <nav aria-label="Site"><a href="/examples" aria-current="true">examples</a> <a href="/docs">docs</a> <a href="<%= @repo %>/releases">releases</a> <a href="<%= @repo %>">source</a></nav>
</header>

<main>
  <section class="hero">
    <p class="eyebrow"><a href="/examples">examples</a> / <%= @n %></p>
    <h1><%= Site.h(@ex.title) %></h1>
    <p class="sub"><%= Site.h(@ex.description) %></p>
  </section>

<%= @machine %>

  <article class="example-body">
    <div class="prose">
<%= @ex.html %>
    </div>

    <nav class="pager" aria-label="Previous and next example">
      <%= if @prev do %><a class="prev" href="/examples/<%= @prev.slug %>"><span class="dir">previous</span><span class="pager-title"><%= Site.h(@prev.title) %></span></a><% else %><a class="prev" href="/examples"><span class="dir">back to</span><span class="pager-title">all examples</span></a><% end %>
      <%= if @next do %><a class="next" href="/examples/<%= @next.slug %>"><span class="dir">next</span><span class="pager-title"><%= Site.h(@next.title) %></span></a><% end %>
    </nav>
    <p class="edit"><a href="<%= @repo %>/blob/main/site/examples/<%= @ex.slug %>.md">this page's source</a></p>
  </article>
</main>

<footer class="foot">
  <span>armless <%= @version %>. BSD 2-Clause.</span>
  <nav aria-label="Footer"><a href="/examples">examples</a> <a href="/docs">docs</a> <a href="<%= @repo %>/releases">releases</a> <a href="<%= @repo %>">source</a></nav>
</footer>
</body>
</html>
