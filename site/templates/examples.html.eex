<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Examples · armless</title>
<meta name="description" content="What armless does, each shown by a machine running in the page.">
<meta property="og:title" content="Examples · armless">
<meta property="og:description" content="What armless does, each shown by a machine running in the page.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="armless">
<meta property="og:url" content="<%= @site %>/examples">
<meta property="og:image" content="<%= @site %>/og.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="armless: arm64 Linux, in a browser tab. Beside the headline, the Mandelbrot set as the page's machine draws it in its console.">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="dark">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/SpaceMono-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/style.css">
</head>
<body class="landing">
<header class="bar">
  <a class="name" href="/">armless</a>
  <nav aria-label="Site"><a href="/examples" aria-current="page">examples</a> <a href="/docs">docs</a> <a href="<%= @repo %>/releases">releases</a> <a href="<%= @repo %>">source</a></nav>
</header>

<main>
  <section class="hero">
    <h1>Examples</h1>
    <p class="sub">What armless does, each shown by a machine running in the page.</p>
  </section>

  <section class="band" aria-label="Examples">
    <%= @list %>
  </section>
</main>

<footer class="foot">
  <span>armless <%= @version %>. BSD 2-Clause.</span>
  <nav aria-label="Footer"><a href="/docs">docs</a> <a href="<%= @repo %>/releases">releases</a> <a href="<%= @repo %>">source</a></nav>
</footer>
</body>
</html>
