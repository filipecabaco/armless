<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>armless: arm64 Linux in a browser tab</title>
<meta name="description" content="armless is an AArch64 machine emulator written in Rust. It boots unmodified arm64 Linux in a browser tab through WebAssembly, and natively through a Rust crate.">
<meta property="og:title" content="armless: arm64 Linux in a browser tab">
<meta property="og:description" content="An AArch64 machine emulator written in Rust. The whole machine, devices included, is Rust.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="armless">
<meta property="og:url" content="<%= @site %>/">
<meta property="og:image" content="<%= @site %>/og.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="armless: arm64 Linux, in a browser tab. Beside the headline, the Mandelbrot set as the page's machine draws it in its console.">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="dark">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/SpaceMono-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/style.css">
<script src="/site.js" defer></script>
<%= if @demo? do %><link rel="stylesheet" href="/demo/xterm.css">
<script src="/machine.js" defer></script>
<script src="/trench.js" defer></script><% end %>
</head>
<body class="landing">
<a class="skip" href="#machine">Skip to the machine</a>

<header class="bar">
  <a class="name" href="/">armless</a>
  <nav aria-label="Site"><a href="/examples">examples</a> <a href="/docs">docs</a> <a href="<%= @repo %>/releases">releases</a> <a href="<%= @repo %>">source</a></nav>
</header>

<main>
  <section class="hero">
    <h1>arm64 Linux,<br>in a browser tab.</h1>
    <p class="sub">An AArch64 machine emulator written in Rust. The whole machine, devices included, is Rust, and its programs can <a href="/examples/gpu">compute on your GPU</a> through WebGPU.</p>
    <p class="actions"><a class="btn btn-primary" href="/docs/getting-started">Read the docs</a> <a class="btn" href="<%= @repo %>/releases">Releases</a></p>
  </section>

<%= @machine %>

  <section class="band" id="examples" aria-labelledby="examples-h">
    <h2 id="examples-h">Examples</h2>
    <%= @examples %>
    <p><a href="/examples">All examples</a></p>
  </section>

  <section class="embed" id="embed" aria-labelledby="embed-h">
    <h2 id="embed-h">Embed it</h2>
    <pre tabindex="0"><code><%= @embed %></code></pre>
    <p><a href="/docs/browser-api">Every option, event and call</a></p>
  </section>
</main>

<footer class="foot">
  <span>armless <%= @version %>. BSD 2-Clause. <a href="https://github.com/filipecabaco/snowglobe">snowglobe</a> uses it.</span>
  <nav aria-label="Footer"><a href="/examples">examples</a> <a href="/docs">docs</a> <a href="<%= @repo %>/releases">releases</a> <a href="<%= @repo %>">source</a></nav>
</footer>
</body>
</html>
