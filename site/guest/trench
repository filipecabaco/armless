#!/bin/sh
# A trench run on every CPU: a cockpit view down the trench of a battle station, TIE fighters
# coming at you, bolts, and at the end of every run (120 frames) a proton torpedo into the exhaust
# port. Every run is a new one: the seed picks the weave, the panels and the fighters. One awk per
# CPU draws every Nth row of each frame, so the rows fill in from all of them at once.
#
#   trench [WIDTH] [HEIGHT]
P=$(nproc)
cpus=CPUs; [ "$P" = 1 ] && cpus=CPU
W=${1:-64}
H=${2:-22}
F=120
# Background jobs of a script start with ctrl+c ignored, so on ctrl+c the script stops its awks
# itself, waits for them, and leaves the cursor under the picture for the prompt
pids=
trap 'kill $pids 2>/dev/null; wait; printf "\033[0m\033[%d;1H\n" $((H + 1)); exit 130' INT
printf '\033[2J'
n=0
while :; do
  f=$((n % F))
  [ $f = 0 ] && seed=$(awk 'BEGIN { srand(); printf "%d", rand() * 1000000 }')
  n=$((n + 1))
  j=0
  pids=
  while [ $j -lt $P ]; do
    awk -v W=$W -v H=$H -v J=$j -v P=$P -v f=$f -v F=$F -v SEED=$seed -f /usr/share/trench.awk &
    pids="$pids $!"
    j=$((j + 1))
  done
  wait
  if [ $f -lt $((F - 22)) ]; then say="stay on target"
  elif [ $f -lt $((F - 8)) ]; then say="torpedoes away"
  else say="it's a hit"; fi
  printf '\033[%d;1H\033[Kframe %d: %s (%d %s)\n' $((H + 1)) $n "$say" $P $cpus
done
