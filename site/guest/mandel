#!/bin/sh
# The Mandelbrot set on every CPU, redrawn in place with more iterations each frame (8 to 128,
# then again). One awk per CPU draws every Nth row of the frame, so the rows fill in from all of
# them at once.
#
#   mandel [WIDTH] [HEIGHT]
P=$(nproc)
cpus=CPUs; [ "$P" = 1 ] && cpus=CPU
W=${1:-64}
H=${2:-22}
# Background jobs of a script start with ctrl+c ignored, so on ctrl+c the script stops its awks
# itself, waits for them, and leaves the cursor under the picture for the prompt
pids=
trap 'kill $pids 2>/dev/null; wait; printf "\033[%d;1H\n" $((H + 1)); exit 130' INT
printf '\033[2J'
n=0
while :; do
  m=$((8 + 8 * (n % 16)))
  n=$((n + 1))
  j=0
  pids=
  while [ $j -lt $P ]; do
    awk -v W=$W -v H=$H -v m=$m -v J=$j -v P=$P -f /usr/share/mandel.awk &
    pids="$pids $!"
    j=$((j + 1))
  done
  wait
  printf '\033[%d;1H\033[Kpass %d: %d iterations on %d %s\n' $((H + 1)) $n $m $P $cpus
done
